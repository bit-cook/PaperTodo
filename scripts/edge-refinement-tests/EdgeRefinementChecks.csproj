<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\PaperTodo.csproj">
      <Aliases>PaperTodoApp</Aliases>
    </ProjectReference>
    <ProjectReference Include="..\..\src\PaperTodo.Core\PaperTodo.Core.csproj">
      <Aliases>global,PaperTodoCore</Aliases>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="PreviewTransferLayoutRegression.cs" />
  </ItemGroup>
</Project>
