<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <AssemblyName>PaperTodo.Avalonia</AssemblyName>
    <RootNamespace>PaperTodo.Avalonia</RootNamespace>
    <ApplicationIcon>..\..\assets\icons\PaperTodo.ico</ApplicationIcon>
    <ApplicationManifest>..\..\app.manifest</ApplicationManifest>

    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <CetCompat>false</CetCompat>

    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AvaloniaTelemetryOptOut>true</AvaloniaTelemetryOptOut>

    <PaperTodoLmdbStaticLibrary>$(MSBuildProjectDirectory)\..\..\native\lmdb\bin\win-x64\papertodo_lmdb_static.lib</PaperTodoLmdbStaticLibrary>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PaperTodo.Core\PaperTodo.Core.csproj" />
    <ProjectReference Include="..\PaperTodo.PluginHost\PaperTodo.PluginHost.csproj" />
    <ProjectReference Include="..\PaperTodo.Platform.Windows\PaperTodo.Platform.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\..\assets\icons\PaperTodo.ico">
      <Link>Assets\PaperTodo.ico</Link>
    </AvaloniaResource>
  </ItemGroup>

  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <DirectPInvoke Include="papertodo_lmdb" />
    <NativeLibrary Include="$(PaperTodoLmdbStaticLibrary)" />
  </ItemGroup>

  <Target
      Name="EnsurePaperTodoAotLmdbLibrary"
      BeforeTargets="Publish"
      Condition="'$(PublishAot)' == 'true'">
    <Error
        Condition="!Exists('$(PaperTodoLmdbStaticLibrary)')"
        Text="PaperTodo's static LMDB library is missing. Build native\lmdb\bin\win-x64\papertodo_lmdb_static.lib before Native AOT publishing." />
  </Target>
</Project>
