<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <AssemblyName>PaperTodo.Core</AssemblyName>
    <RootNamespace>PaperTodo</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PaperTodo" />
    <InternalsVisibleTo Include="PaperTodo.Avalonia" />
    <InternalsVisibleTo Include="PaperTodo.Platform.Windows" />
    <InternalsVisibleTo Include="EdgeRefinementChecks" />
  </ItemGroup>
</Project>
